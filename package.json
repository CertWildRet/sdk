{
  "name": "@cwr/sdk",
  "version": "0.8.0",
  "description": "TypeScript SDK for Diamond Pools, the multi-pool vault on Solana (dORE = exposure to ORE, dZINC = exposure to ZINC). Wraps @cwr/abi with typed methods, PDA derivation, event subscriptions, and off-chain math previews.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "example:deposit": "tsx examples/01-simple-deposit.ts",
    "example:autoclaim": "tsx examples/02-auto-claim.ts",
    "example:navsub": "tsx examples/03-nav-subscriber.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@cwr/abi": "github:CertWildRet/abi#d28341b",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
